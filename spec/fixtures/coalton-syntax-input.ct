(coalton-toplevel
  (declare add-samples (Integer -> Integer))
  (define (add-samples seed)
    (let xs = [seed (+ seed 1) (+ seed 2)])
    (let transformed = (map ƒx.(+ x 1) xs))
    (fold + 0 transformed))
  (declare sum-even-squares (UFix -> UFix))
  (define (sum-even-squares limit)
    (let values = [(* x x) :for x :below limit :when (even? x)])
    (fold + 0 (map ƒx.(+ x 1) values)))
  (declare pair-total (UFix -> UFix))
  (define (pair-total _)
    (fold (fn (acc (Tuple _ value)) (+ acc value))
          0 [x => (* x x) :for x :below 5]))
  (declare for-sum (UFix -> UFix))
  (define (for-sum limit)
    (for :scan ((i 0 (1+ i)) (total 0 (+ total i)))
      :returns total :until (>= i limit) (values)))
  (declare tuple-example (Integer -> Integer))
  (define (tuple-example n)
    (let (Tuple first second) = (Tuple n 2))
    (+ first second))
  (declare do-example (Integer -> Result String Integer))
  (define (do-example n)
    (do (x <- (Ok n)) (let y = (+ x 1)) (pure y)))
  (declare cl-next (Integer -> Integer))
  (define (cl-next x)
    (lisp (-> Integer) (x) (cl:let ((next (cl:1+ x))) next))))
